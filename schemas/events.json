{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "title",
    "description",
    "date",
    "type",
    "location",
    "demo"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "enum": [
        "Hackathon",
        "Workshop",
        "Deadline",
        "Club session"
      ]
    },
    "location": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "demo": {
      "type": "boolean"
    }
  }
}
